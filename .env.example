# MongoDB Atlas connection string. Store real credentials in .env or atlas-credentials.env.
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/?appName=<app-name>
MONGODB_DATABASE=smart_hostel
BACKEND_CORS_ORIGINS=http://localhost:5173
APP_ENVIRONMENT=development
# Generate a unique secret (at least 32 random bytes) for each deployment.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
